# Application
NODE_ENV=development
PORT=5000

# Database
DB_URL=mongodb://localhost:27017/evotech
# Or for MongoDB Atlas:
# DB_URL=mongodb+srv://username:password@cluster.mongodb.net/evotech?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-this
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_REFRESH_EXPIRES_IN=30d

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Admin Credentials (for seeding)
ADMIN_EMAIL=admin@evotech.com
ADMIN_PASSWORD=Admin@123
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=123
ADMIN_PHONE=+1234567890

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# CORS
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Public URL of this backend
BACKEND_URL=http://localhost:5000

# EPS Payment Gateway (credentials from the EPS merchant panel)
# EPS_SANDBOX=true uses sandboxpgapi.eps.com.bd, otherwise pgapi.eps.com.bd
EPS_SANDBOX=true
# Storefront origin EPS returns customers to; must be the domain registered
# with EPS (live: https://evo-techbd.com). Defaults to FRONTEND_URL.
EPS_CALLBACK_BASE_URL=http://localhost:3000
EPS_USERNAME=merchant@example.com
EPS_PASSWORD=your-eps-password
EPS_HASH_KEY=your-eps-hash-key
EPS_MERCHANT_ID=your-eps-merchant-id
EPS_STORE_ID=your-eps-store-id

# Payment Gateway (optional - for future implementation)
# STRIPE_SECRET_KEY=your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM_NAME=Evo-Tech Bangladesh
